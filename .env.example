# ==============================================================================
# Game Server Health (GSH) Monitor - Environment Configuration Example
# ==============================================================================

# Database Configuration (PostgreSQL / TimescaleDB)
# Docker ichida (docker compose up da) — alerting-service shu URLni ishlatadi:
DB_URL=postgresql://postgres:postgrespassword@timescaledb:5432/game_monitor
# Local host (docker tashqarida test qilganda):
# DB_URL=postgresql://postgres:postgrespassword@localhost:5433/game_monitor

# Redis Configuration (Redis Streams & Queue)
# Local host access:
REDIS_URL=redis://localhost:6379
# Docker internal network access:
# REDIS_URL=redis://redis:6379

# Gateway API Configuration
GATEWAY_PORT=8000
INGESTION_PORT=8001
ANOMALY_ML_PORT=8002

# Client Dashboard (for client/.env)
VITE_API_URL=http://localhost:8000

# ==============================================================================
# Alerting Service — Telegram Bot
# ==============================================================================
# 1. @BotFather dan yangi bot ochasiz va tokenni olasiz:
TELEGRAM_BOT_TOKEN=your_telegram_bot_api
# 2. Guruh chat ID sini bilish uchun:
#    - Botni guruhga qo'shing
#    - https://api.telegram.org/bot<TOKEN>/getUpdates ga kiring
#    - "chat":{"id": -100xxxxxxxxx} — shu raqamni ko'chirib qo'ying
TELEGRAM_CHAT_ID=-100****

# --- SCHEDULER REJIMI ---
# "interval" = test rejimi (har N daqiqada)
# "daily"    = production rejimi (kuniga 1 marta)
SCHEDULER_MODE=interval

# Interval rejimi sozlamalari:
REPORT_INTERVAL_MINUTES=5     # har necha daqiqada yuborsin
LOOKBACK_MINUTES=5            # so'nggi necha daqiqa datani tahlil qilsin

# Daily rejimi sozlamalari (SCHEDULER_MODE=daily bo'lganda):
REPORT_HOUR_UTC=9
REPORT_MINUTE_UTC=0
LOOKBACK_DAYS=1

# true = container ishga tushganda DARHOL bir hisobot yuboradi (test uchun)
SEND_ON_STARTUP=true
