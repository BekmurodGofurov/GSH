# ==============================================================================
# Game Server Health (GSH) Monitor - Environment Configuration Example
# ==============================================================================

# Database Configuration (PostgreSQL / TimescaleDB)
POSTGRES_PASSWORD=your_secure_postgres_password
TIMESCALE_CONTAINER_PORT=
TIMESCALE_HOST_PORT=

# ==============================================================================
# Host / Domain Configuration
# ==============================================================================
# Server Public IP or Domain (without http:// or port, e.g.: localhost, 13.53.211.157, or yourdomain.com)
HOST=localhost

# Service Ports (single fixed port for each service)
REDIS_PORT=6379
GATEWAY_PORT=8000
INGESTION_PORT=8001
ANOMALY_ML_PORT=8002
ROOT_CAUSE_ML_PORT=8003
CLIENT_PORT=3000

# Client (Frontend) Configuration
# (By default, FRONTEND_URL, VITE_API_URL, and VITE_WS_URL are automatically derived from HOST and ports)
# FRONTEND_URL=http://localhost:3000
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000/ws/live
VITE_ADMIN_PATH=/secret-admin

# Optional: Specify only if connecting to an external/remote server
# (By default, docker-compose automatically generates these with the correct ports):
# DB_URL=
# REDIS_URL=

# ==============================================================================
# Admin Panel Security
# ==============================================================================
# The credentials required to access the admin panel
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# ==============================================================================
# Alerting Service — Telegram Bot
# ==============================================================================
# 1. Create a new bot from @BotFather and get the token:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# 2. To find out the group chat ID:
#    - Add the bot to the group
#    - Go to https://api.telegram.org/bot<TOKEN>/getUpdates
#    - Find "chat":{"id": -100xxxxxxxxx} — copy that number here
TELEGRAM_CHAT_ID=your_telegram_group_id

# Daily mode settings:
REPORT_HOUR_UTC=9
REPORT_MINUTE_UTC=0
LOOKBACK_DAYS=1

# true = send a report IMMEDIATELY when the container starts (for testing)
SEND_ON_STARTUP=true

# ==============================================================================
# Agent — LLM Provider (Gemini)
# ==============================================================================
# Gemini API key for the in-product agent harness (POST /api/v1/agent/ask).
# Get a free key at https://aistudio.google.com/app/apikey
#
# REQUIRED -- not optional. gateway-api/app/agent/router.py raises ValueError
# at import when this is empty, and main.py imports that module at load time,
# so an empty value stops the whole gateway from starting (not just the agent
# endpoint). docker-compose marks it :? so you get one clear message instead
# of a restart loop.
AGENT_LLM_API_KEY=

# Optional: Gemini model id. Leave empty to use the code default.
# Google retires model ids over time -- when the agent starts answering
# with "LLM provider error ... 404 ... no longer available", the message
# names the replacement id; put it here and restart gateway-api.
# AGENT_LLM_MODEL=

# ==============================================================================
# Optional
# ==============================================================================
# Service-to-service admin credential, sent as the X-API-Key header.
#
# Required for voice: the voice worker calls the gateway's P2 endpoints
# (mute, acknowledge, daily report) with it, and they answer 403 without
# it even when an admin is the one speaking. Browsers never use it -- the
# dashboard authenticates with its admin session cookie instead.
#
# Anyone holding this value has full admin API access, so generate your
# own and give dev and production different ones:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_API_KEY=

# Seconds between anomaly-bridge polling cycles. Default 5.
# BRIDGE_POLL_INTERVAL=5

# ==============================================================================
# LiveKit Cloud — Voice Live Chat
# ==============================================================================
# 1. Sign up at https://livekit.io — no credit card needed for the free tier.
# 2. Create a project in the LiveKit Console.
# 3. Copy the values from Settings → API Keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Which voice worker answers this stack's rooms. Defaults to
# "<COMPOSE_PROJECT_NAME>-voice", so dev and production each dispatch their
# own worker. Only set this if you want to override that -- and if you do,
# set it before starting, because gateway-api and voice-agent must agree.
# VOICE_AGENT_NAME=

# The realtime model the voice assistant speaks with, and its prebuilt
# voice. Leave empty to use the code defaults (gemini-3.8-live / Puck).
# Changing the model changes how the assistant sounds. It must support
# bidiGenerateContent -- list the current ones with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$AGENT_LLM_API_KEY"
# AGENT_VOICE_MODEL=
# AGENT_VOICE=
