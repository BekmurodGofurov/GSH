# ==============================================================================
# Game Server Health (GSH) Monitor - Environment Configuration Example
# ==============================================================================

# Database Configuration (PostgreSQL / TimescaleDB)
POSTGRES_PASSWORD=your_secure_postgres_password
TIMESCALE_CONTAINER_PORT=
TIMESCALE_HOST_PORT=

# ==============================================================================
# Host / Domain Configuration
# ==============================================================================
# Server Public IP or Domain (without http:// or port, e.g.: localhost, 13.53.211.157, or yourdomain.com)
HOST=localhost

# Service Ports (single fixed port for each service)
REDIS_PORT=6379
GATEWAY_PORT=8000
INGESTION_PORT=8001
ANOMALY_ML_PORT=8002
ROOT_CAUSE_ML_PORT=8003
CLIENT_PORT=3000

# Client (Frontend) Configuration
# (By default, FRONTEND_URL, VITE_API_URL, and VITE_WS_URL are automatically derived from HOST and ports)
# FRONTEND_URL=http://localhost:3000
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000/ws/live
VITE_ADMIN_PATH=/secret-admin

# Optional: Specify only if connecting to an external/remote server
# (By default, docker-compose automatically generates these with the correct ports):
# DB_URL=
# REDIS_URL=

# ==============================================================================
# Admin Panel Security
# ==============================================================================
# The credentials required to access the admin panel
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# ==============================================================================
# Alerting Service — Telegram Bot
# ==============================================================================
# 1. Create a new bot from @BotFather and get the token:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# 2. To find out the group chat ID:
#    - Add the bot to the group
#    - Go to https://api.telegram.org/bot<TOKEN>/getUpdates
#    - Find "chat":{"id": -100xxxxxxxxx} — copy that number here
TELEGRAM_CHAT_ID=your_telegram_group_id

# Daily mode settings:
REPORT_HOUR_UTC=9
REPORT_MINUTE_UTC=0
LOOKBACK_DAYS=1

# true = send a report IMMEDIATELY when the container starts (for testing)
SEND_ON_STARTUP=true

# ==============================================================================
# Agent — LLM Provider (Gemini)
# ==============================================================================
# Gemini API key for the in-product agent harness (POST /api/v1/agent/ask).
# Get a free key at https://aistudio.google.com/app/apikey
#
# REQUIRED -- not optional. gateway-api/app/agent/router.py raises ValueError
# at import when this is empty, and main.py imports that module at load time,
# so an empty value stops the whole gateway from starting (not just the agent
# endpoint). docker-compose marks it :? so you get one clear message instead
# of a restart loop.
AGENT_LLM_API_KEY=

# Optional: Gemini model id. Leave empty to use the code default.
# Google retires model ids over time -- when the agent starts answering
# with "LLM provider error ... 404 ... no longer available", the message
# names the replacement id; put it here and restart gateway-api.
# AGENT_LLM_MODEL=

# ==============================================================================
# Optional
# ==============================================================================
# Second admin auth path: send this value as the X-API-Key header instead of
# logging in for a session cookie. Empty (the default) disables it.
# ADMIN_API_KEY=

# Seconds between anomaly-bridge polling cycles. Default 5.
# BRIDGE_POLL_INTERVAL=5
