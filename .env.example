# ==============================================================================
# Game Server Health (GSH) Monitor - Environment Configuration Example
# ==============================================================================

# Database Configuration (PostgreSQL / TimescaleDB)
# Local host access (e.g. running scripts outside Docker):
DB_URL=postgresql://postgres:postgrespassword@localhost:5433/game_monitor
# Docker internal network access:
# DB_URL=postgresql://postgres:postgrespassword@timescaledb:5432/game_monitor

# Redis Configuration (Redis Streams & Queue)
# Local host access:
REDIS_URL=redis://localhost:6379
# Docker internal network access:
# REDIS_URL=redis://redis:6379

# Gateway API Configuration
GATEWAY_PORT=8000
INGESTION_PORT=8001
ANOMALY_ML_PORT=8002

# Client Dashboard (for client/.env)
VITE_API_URL=http://localhost:8000
