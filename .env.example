# ==============================================================================
# Game Server Health (GSH) Monitor - Environment Configuration Example
# ==============================================================================

# Database Configuration (PostgreSQL / TimescaleDB)
POSTGRES_PASSWORD=your_secure_postgres_password
DB_URL=postgresql://postgres:${POSTGRES_PASSWORD}@timescaledb:5432/game_monitor

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Gateway API Configuration
GATEWAY_PORT=8000
INGESTION_PORT=8001
ANOMALY_ML_PORT=8002

# Client Dashboard (for client/.env)
VITE_API_URL=http://localhost:8000

# ==============================================================================
# Admin Panel Security
# ==============================================================================
# The credentials required to access the admin panel
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# Allowed frontend origin (CORS) - Set to http://localhost:3000 for local dev
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# Alerting Service — Telegram Bot
# ==============================================================================
# 1. Create a new bot from @BotFather and get the token:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# 2. To find out the group chat ID:
#    - Add the bot to the group
#    - Go to https://api.telegram.org/bot<TOKEN>/getUpdates
#    - Find "chat":{"id": -100xxxxxxxxx} — copy that number here
TELEGRAM_CHAT_ID=your telegram group id

# Daily mode settings:
REPORT_HOUR_UTC=9
REPORT_MINUTE_UTC=0
LOOKBACK_DAYS=1

# true = send a report IMMEDIATELY when the container starts (for testing)
SEND_ON_STARTUP=true
