# CS2 Pulse Client Environment Configuration
#
# Local (non-docker) `npm run dev` only. Under `docker compose up`, these
# come from the root .env via the client service's `environment:` block.
#
# vite.config.js throws at startup if VITE_API_URL or CLIENT_PORT is empty.

VITE_API_URL=http://<api_host>:8000
VITE_WS_URL=ws://<api_host>:8000/ws/live
VITE_ADMIN_PATH=/secret-admin
CLIENT_PORT=3000
