# Local (non-docker) runs only. Nothing loads this file automatically --
# no service calls load_dotenv() -- so export it yourself or point your
# IDE at it. Under `docker compose up`, values come from the root .env
# via each service's `environment:` block instead.

# Host port must match TIMESCALE_HOST_PORT in the root .env (default 5434).
DB_URL=postgresql://postgres:<password>@localhost:5434/game_monitor
REDIS_URL=redis://localhost:6379
PORT=8001
FRONTEND_URL=http://localhost:3000
